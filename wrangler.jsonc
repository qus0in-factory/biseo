{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biseo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "routes": [{ "pattern": "biseo.qus0in.dev", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "HEALTH_TIMEOUT_MS": "5000",
    "COOKIE_NAME": "biseo_session",
    "COOKIE_SAME_SITE": "Lax",
    "COOKIE_MAX_AGE_SECONDS": "3600",
    "TOKEN_TTL_SECONDS": "3600",
    "TOKEN_ISSUER": "biseo",
    "TOKEN_AUDIENCE": "biseo-user",
    "CLOCK_TOLERANCE_SECONDS": "5",
    "SESSION_SUBJECT": "owner",
    "SERVICE_TOKEN_ISSUER": "biseo",
    "SERVICE_TOKEN_AUDIENCE": "biseo-service",
    "SERVICE_TOKEN_TTL_SECONDS": "300",
    "SERVICE_TOKEN_SUBJECT": "biseo-worker",
    "LOGIN_MAX_ATTEMPTS": "5",
    "LOGIN_ATTEMPT_TTL_SECONDS": "60",
    "WORKSPACE_CONFIG_SOURCE": "server",
    "UPSTREAM_TIMEOUT_MS": "10000",
    "ALLOWED_ORIGINS": "https://biseo.qus0in.workers.dev,https://biseo.qus0in.dev"
  },
  "kv_namespaces": [
    {
      "binding": "LOGIN_ATTEMPTS",
      "id": "dc4ef10d3a9e4153a93e44fdcab18fba"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
  // D1 is intentionally not bound yet: no approved biseo database exists.
  // After approval, create the DB, add the real id, and apply worker/migrations:
  // "d1_databases": [{
  //   "binding": "BISEO_DB",
  //   "database_name": "biseo",
  //   "database_id": "<approved-d1-database-id>",
  //   "migrations_dir": "worker/migrations"
  // }]
}
