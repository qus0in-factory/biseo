# wrangler dev용 로컬 값. 이 파일을 .dev.vars로 복사해 채운다. 운영은 wrangler secret put으로 등록한다.
FUNNEL_HEALTH_URL=https://<device>.<tailnet>.ts.net/health
AUTH_PASSWORD_VERIFIER=
USER_SESSION_PASETO_SECRET=
SERVICE_PASETO_SECRET=

# 0.3.0: local backend and Worker must use the same workspace ID.
ALLOWED_WORKSPACE_ID=<workspace-id>
# Optional: defaults to the origin of FUNNEL_HEALTH_URL.
FUNNEL_BASE_URL=
UPSTREAM_TIMEOUT_MS=10000
# Optional comma-separated trusted browser origins; empty permits same-origin only.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:5173

# Optional: set only when sharing cookies across subdomains.
# Default (unset) is host-only cookies, recommended for workers.dev + custom domain.
# COOKIE_DOMAIN=biseo.qus0in.dev
