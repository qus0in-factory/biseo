{
  "name": "biseo",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server/src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:server:clean": "rm -rf dist/server && pnpm build:server",
    "build:client": "vite build",
    "build": "pnpm build:server && pnpm build:client",
    "preflight": "node scripts/deploy-preflight.mjs",
    "release": "pnpm build:server:clean && pnpm preflight && pnpm pm2:restart",
    "secret:verifier": "bash scripts/make-verifier.sh",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json && tsc --noEmit",
    "test": "tsc -p shared/tsconfig.json --noEmit && tsx --test $(find shared worker src web -name '*.test.ts' | sort)",
    "dev": "pnpm build:client && wrangler dev",
    "deploy": "pnpm build:client && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "hono": "^4.13.14",
    "ky": "^2.2.0",
    "lucide-react": "^1.62.0",
    "paseto": "^4.0.1",
    "pele": "^1.12.0",
    "pino": "^10.4.0",
    "pretendard": "1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pm2": "7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  }
}
